# API reference for the public headers. Build with: doxygen
# Output: build-docs/html/index.html. Undocumented public symbols fail the build.
PROJECT_NAME           = kalman-c
PROJECT_BRIEF          = "Embedded-friendly Kalman filters in C99"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = include/kalman
FILE_PATTERNS          = *.h
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
TYPEDEF_HIDES_STRUCT   = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = KF_RESTRICT=
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
